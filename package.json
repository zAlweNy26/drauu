{
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "play:dev": "bun run --cwd playground dev",
    "play:build": "bun run --cwd playground build",
    "js:dev": "bun run --parallel --filter './packages/*' dev",
    "js:build": "bun run --filter './packages/*' build",
    "dev": "nr play:dev",
    "build": "nr js:build",
    "lint": "eslint .",
    "release": "bumpp -r"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@antfu/ni": "^30.5.0",
    "@types/node": "^25.0.7",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "nanoevents": "^10.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.x"
  },
  "workspaces": [
    "playground",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ]
}
